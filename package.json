{
  "name": "tokenboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "dev": "pnpm --filter @tokenboard/web dev",
    "build": "pnpm --filter @tokenboard/web build",
    "preview": "pnpm --filter @tokenboard/web preview",
    "deploy": "pnpm --filter @tokenboard/web run deploy",
    "format": "prettier --write '**/*.{js,mjs,ts,tsx,json,jsonc}'",
    "format:check": "prettier --check '**/*.{js,mjs,ts,tsx,json,jsonc}'",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
